<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CargoPlus</RootNamespace>
    <AssemblyName>CargoPlus</AssemblyName>
    <ApplicationTitle>Cargo Plus</ApplicationTitle>
    <Version>1.0.43</Version>
    <FileVersion>1.0.43.0</FileVersion>
    <AssemblyVersion>1.0.43.0</AssemblyVersion>
    <InformationalVersion>1.0.43</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>brand\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CargoPlus\**" />
    <Compile Remove="obj\**" />
    <Compile Remove="bin\**" />
    <Content Remove="CargoPlus\**" />
    <Content Remove="obj\**" />
    <Content Remove="bin\**" />
    <EmbeddedResource Remove="CargoPlus\**" />
    <EmbeddedResource Remove="obj\**" />
    <EmbeddedResource Remove="bin\**" />
    <None Remove="CargoPlus\**" />
    <None Remove="obj\**" />
    <None Remove="bin\**" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AppVersion</_Parameter1>
      <_Parameter2>$(Version)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
